# Copy to .env and fill in. https://aisa.one (OpenAI-compatible API)

# Base URL — aisa.one gateway (note the api. subdomain)
AISA_BASE_URL=https://api.aisa.one/v1

# Model — best GPT. "auto" picks the strongest available
# (gpt-5.5-pro > gpt-5.5 > gpt-5-pro > gpt-5 > o3 > opus > ...),
# or pin an exact id, e.g. gpt-5.5-pro
AISA_MODEL=gpt-5.5-pro

# API keys — put as MANY as you have, comma-separated. The script rotates them and
# puts any rate-limited key on a 60s cooldown, switching to the next automatically.
AISA_API_KEYS=key1,key2,key3

# (Alternative: one per line instead of the comma list above)
# AISA_API_KEY_1=key1
# AISA_API_KEY_2=key2
# AISA_API_KEY_3=key3
